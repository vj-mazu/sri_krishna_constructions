datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  STAFF
  SUPERVISOR
}



enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  EDIT_ATTENDANCE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  fullName        String
  mobileNumber    String
  password        String
  role            Role             @default(STAFF)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  purchaseOrders  PurchaseOrder[]  @relation("POAddedBy")
  purchasesAdded  Purchase[]       @relation("PurchaseAddedBy")
  salesAdded      Sale[]           @relation("SaleAddedBy")
  approvalRequests ApprovalRequest[] @relation("RequestedBy")
  approvedRequests ApprovalRequest[] @relation("ApprovedBy")
  auditLogs       AuditLog[]
  attendances     Attendance[]

  @@index([role])
}

model PurchaseOrder {
  id            String    @id @default(uuid())
  poNumber      String    @unique
  date          DateTime
  divisionId    String
  division      Division  @relation(fields: [divisionId], references: [id])
  poAmount      Float
  addedById     String
  addedBy       User      @relation("POAddedBy", fields: [addedById], references: [id])
  items         PurchaseOrderItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([poNumber])
  @@index([date])
  @@index([divisionId])
}

model PurchaseOrderItem {
  id              String    @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  kpclCode        String
  itemName        String
  specifications  String?
  partNumber      String    @unique
  make            String?
  hsnCode         String?
  unit            String     @default("NOS")
  qty             Float
  rate            Float
  basicAmount     Float
  discount        Float      @default(0)
  freight         Float      @default(0)
  pAndF           Float      @default(0)
  cgstPercent     Float      @default(0)
  sgstPercent     Float      @default(0)
  igstPercent     Float      @default(0)
  cgstAmount      Float      @default(0)
  sgstAmount      Float      @default(0)
  igstAmount      Float      @default(0)
  insurance       Float      @default(0)
  totalAmount     Float
  purchases       Purchase[]
  sales           Sale[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([kpclCode])
  @@index([purchaseOrderId])
  @@index([partNumber])
  @@index([itemName])
  @@index([purchaseOrderId, partNumber])
  @@index([purchaseOrderId, kpclCode])
}

model Purchase {
  id                  String    @id @default(uuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  date                DateTime
  qty                 Float
  rate                Float
  basicAmount         Float
  cgstPercent         Float     @default(0)
  sgstPercent         Float     @default(0)
  igstPercent         Float     @default(0)
  cgstAmount          Float     @default(0)
  sgstAmount          Float     @default(0)
  igstAmount          Float     @default(0)
  totalAmount         Float
  addedById           String
  addedBy             User      @relation("PurchaseAddedBy", fields: [addedById], references: [id])
  createdAt           DateTime  @default(now())

  @@index([purchaseOrderItemId])
  @@index([date])
}

model Sale {
  id                  String    @id @default(uuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  invoiceNumber       String
  invoiceDate         DateTime
  qty                 Float
  rate                Float
  basicAmount         Float
  cgstPercent         Float     @default(0)
  sgstPercent         Float     @default(0)
  igstPercent         Float     @default(0)
  cgstAmount          Float     @default(0)
  sgstAmount          Float     @default(0)
  igstAmount          Float     @default(0)
  totalAmount         Float
  addedById           String
  addedBy             User      @relation("SaleAddedBy", fields: [addedById], references: [id])
  createdAt           DateTime  @default(now())

  @@index([purchaseOrderItemId])
  @@index([invoiceDate])
  @@index([invoiceNumber])
}

model ApprovalRequest {
  id             String         @id @default(uuid())
  type           ApprovalType
  status         ApprovalStatus @default(PENDING)
  requestedById  String
  requestedBy    User           @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById   String?
  approvedBy     User?          @relation("ApprovedBy", fields: [approvedById], references: [id])
  payload        Json
  reason         String?
  rejectionReason String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([requestedById])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Division {
  id        String   @id @default(uuid())
  name      String   @unique
  workers   Worker[]
  purchaseOrders PurchaseOrder[]
  attendances Attendance[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Worker {
  id            String           @id @default(uuid())
  workerId      String           @unique
  fullName      String
  fatherName    String?
  designation   String?
  mobileNumber  String
  dailyWage     Float
  dailyAllowance Float           @default(0.0)
  advanceTaken  Float            @default(0.0)
  advanceBalance Float           @default(0.0)
  otAllowance   Float            @default(0.0)
  otHourlyRate  Float            @default(0.0)
  pfNumber      String?
  esiNumber     String?
  uanNumber     String?
  bankAccountNo String?
  ifscCode      String?
  placeOfWork   String?
  natureOfWork  String?
  divisionId    String
  division      Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  attendances   Attendance[]
  payments      MonthlyPayment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([divisionId])
  @@index([fullName])
}

model Attendance {
  id            String           @id @default(uuid())
  workerId      String
  worker        Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  divisionId    String?
  division      Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  date          DateTime
  status        AttendanceStatus
  overtimeHours Float            @default(0.0)
  dailyWageOverride Float?
  recordedById  String
  recordedBy    User             @relation(fields: [recordedById], references: [id])
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([workerId, date])
  @@index([workerId, date])
  @@index([date])
  @@index([divisionId])
}

model MonthlyPayment {
  id               String        @id @default(uuid())
  workerId         String
  worker           Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)
  month            Int
  year             Int
  presentDays      Float         @default(0.0)
  absentDays       Float         @default(0.0)
  halfDays         Float         @default(0.0)
  leaveDays        Float         @default(0.0)
  totalOtHours     Float         @default(0.0)
  wagesAmount      Float         @default(0.0)
  allowanceAmount  Float         @default(0.0)
  grossPayment     Float         @default(0.0)
  pfAmount         Float         @default(0.0)
  esiAmount        Float         @default(0.0)
  netBaseAmount    Float         @default(0.0)
  otPayment        Float         @default(0.0)
  otAllowance      Float         @default(0.0)
  totalPayment     Float         @default(0.0)
  advanceDeducted  Float         @default(0.0)
  extraAmount      Float         @default(0.0)
  finalNetAmount   Float         @default(0.0)
  calculatedAmount Float
  divisionSummary  Json?
  status           PaymentStatus @default(PENDING)
  approvedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([workerId, month, year])
  @@index([workerId, month, year])
  @@index([month, year])
}
